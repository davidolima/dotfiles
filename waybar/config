{
    "layer": "bottom",
    "position": "top",
    "height": 20,
    "ipc": true,

    "modules-left": ["wlr/workspaces", "tray"],
    "modules-center": ["clock"],
    "modules-right": ["custom/spotify", "memory", "cpu", "pulseaudio", "battery", "network"],
    "wlr/workspaces": {
        "format": "{name}",
        "disable-scroll": true
    },
    "wlr/taskbar": {
        "tooltip": true
    },
    "clock": {
        "format": "{:%H:%M - %a, %d %b}",
        "format-alt": "{:%H:%M}",
        "tooltip": false
    },
    "battery": {
        "format": " {icon} {capacity}%",
        "format-alt": "{icon} {time}",
        "format-icons": ["", "", "", "", ""],
        "format-charging": " {capacity}%",
        "interval": 30,
        "states": {
            "warning": 25,
            "critical": 15
        },
        "tooltip": false
    },
    "network": {
        "format": "{icon}",
        "format-alt": "{ipaddr} {icon}",
        "format-alt-click": "click-right",
        "format-icons": {
            "wifi": ["", "" ,""],
            "ethernet": [""],
            "disconnected": [""]
        },
        "on-click": "alacritty -e nmtui",
    "tooltip": true
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-alt": "{volume} {icon}",
        "format-alt-click": "click-right",
        "format-muted": "婢",
        "format-icons": {
            "phone": [" 奄", " 奔", " ", " 墳"],
            "default": ["奄", "奔", "", "墳"]
        },
        "scroll-step": 10,
        "on-click": "pavucontrol",
        "tooltip": false
    },
    "custom/spotify": {
        "interval": 1,
        "return-type": "json",
        "exec": "~/.config/waybar/modules/spotify.sh",
        "exec-if": "pgrep spotify",
        "escape": true
    },
    "custom/storage": {
        "format": "{} ",
        "format-alt": "{percentage}% ",
        "format-alt-click": "click-right",
        "return-type": "json",
        "interval": 60,
        "exec": "~/.config/waybar/modules/storage.sh"
    },
    "tray": {
        "icon-size": 18
    },
    "memory": {
        "interval": 10,
        "format": " {}%",
        "tooltip": true
    },
    "cpu": {
        "interval": 10,
        "format": "{usage}% זּ",
        "max-lenght": 10,
        "tooltip": true
    }
}
