{
    "layer": "top",
    "position": "top",
    "height": 20,
    "ipc": true,

    "modules-left": ["wlr/workspaces", "tray"],
    "modules-center": ["clock"],
    "modules-right": ["custom/spotify", "memory", "cpu", "battery", "network"],
    "wlr/workspaces": {
        "format": "{name}",
        "disable-scroll": true
    },
    "wlr/taskbar": {
        "tooltip": true
    },
    "clock": {
        "format": "{:%H:%M - %a, %d %b}",
        "format-alt": "{:%H:%M}",
        "tooltip": false
    },
    "battery": {
        "format": " {icon} {capacity}%",
        "format-alt": "{icon} {time}",
        "format-icons": ["󰂎","󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "format-charging": "󱐋{icon} {capacity}%",
        "interval": 30,
        "states": {
            "warning": 25,
            "critical": 15
        },
        "tooltip": true,
        "tooltip-format": "Tempo restante: {time}"
    },
    "network": {
        "max-length": 10,
        "format": "{icon}",
        "on-click": "alacritty -e nmtui",
        "format-icons": {
            //"wifi": ["", "" ,""],
            //"disconnected": [""]
            "wifi": ["󰤟", "󰤢", "󰤥", "󰤨"],
            "ethernet": ["󰈁"],
            "disconnected": ["󰕑"]
        },
        "tooltip": true,
        "tooltip-format": "ssid: {essid} ip: {ipaddr}",
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-alt": "{volume} {icon}",
        "format-alt-click": "click-right",
        "format-muted": "婢",
        "format-icons": {
            "phone": [" 奄", " 奔", " ", " 墳"],
            "default": ["奄", "奔", "", "墳"]
        },
        "scroll-step": 10,
        "on-click": "pavucontrol",
        "tooltip": false
    },
    "custom/spotify": {
        "interval": 1,
        "return-type": "json",
        "exec": "~/.config/waybar/modules/spotify.sh",
        "exec-if": "pgrep spotify",
        "escape": true
    },
    "custom/storage": {
        "format": "{} ",
        "format-alt": "{percentage}% ",
        "format-alt-click": "click-right",
        "return-type": "json",
        "interval": 60,
        "exec": "~/.config/waybar/modules/storage.sh"
    },
    "tray": {
        "icon-size": 18
    },
    "memory": {
        "interval": 10,
        "format": "󱗼 {}%",
        "tooltip": true
    },
    "cpu": {
        "interval": 10,
        "format": "󰍛 {usage}%",
        "max-lenght": 10,
        "tooltip": true
    }
}
